<Application x:Class="Roamwise.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Replaced from the Windows accent color at startup. -->
            <SolidColorBrush x:Key="Rw.Accent" Color="#60CDFF" />
            <SolidColorBrush x:Key="Rw.AccentText" Color="#99EBFF" />
            <SolidColorBrush x:Key="Rw.AccentSoft" Color="#7060CDFF" />
            <SolidColorBrush x:Key="Rw.OnAccent" Color="#000000" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
