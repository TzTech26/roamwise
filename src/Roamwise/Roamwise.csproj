<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Roamwise.ico</ApplicationIcon>
    <AssemblyName>Roamwise</AssemblyName>
    <RootNamespace>Roamwise</RootNamespace>
    <Description>Keeps your PC on the best Wi-Fi access point.</Description>
    <!-- WPF Fluent theme (Application.ThemeMode) is marked experimental. -->
    <!-- Release builds ship as one self-contained exe; no .NET install needed. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <!-- WinForms is only used for the tray icon; keep its global usings out of WPF code. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Roamwise.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Roamwise.Core\Roamwise.Core.csproj" />
  </ItemGroup>

</Project>
