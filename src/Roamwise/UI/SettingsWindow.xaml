<Window x:Class="Roamwise.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Roamwise.UI"
        xmlns:core="clr-namespace:Roamwise.Core"
        Style="{x:Null}"
        Title="Roamwise settings" Width="880" Height="680" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Rw.FontText}" Foreground="{DynamicResource Rw.Text}"
        Background="{DynamicResource Rw.FlyoutFallback}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <ui:DbmConverter x:Key="Dbm" />
        <ui:PlusDbConverter x:Key="PlusDb" />
        <ui:DurationConverter x:Key="Duration" />
        <ui:ChecksConverter x:Key="Checks" />
        <ui:EnumIsConverter x:Key="Is" />
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <StackPanel Margin="12,16,8,16">
            <StackPanel Orientation="Horizontal" Margin="12,0,0,20">
                <Image Source="{StaticResource Rw.Logo}" Width="20" Height="20" />
                <TextBlock Text="Roamwise" Style="{StaticResource Rw.Subtitle}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <RadioButton x:Name="NavGeneral" Style="{StaticResource Rw.NavItem}" GroupName="Nav" Tag="&#xE713;" Content="General" IsChecked="True" Checked="Nav_Checked" />
            <RadioButton x:Name="NavRoaming" Style="{StaticResource Rw.NavItem}" GroupName="Nav" Tag="&#xE701;" Content="Switching" Checked="Nav_Checked" />
            <RadioButton x:Name="NavRanking" Style="{StaticResource Rw.NavItem}" GroupName="Nav" Tag="&#xE9D2;" Content="Ranking" Checked="Nav_Checked" />
            <RadioButton x:Name="NavNetworks" Style="{StaticResource Rw.NavItem}" GroupName="Nav" Tag="&#xE8FD;" Content="Networks" Checked="Nav_Checked" />
            <RadioButton x:Name="NavNames" Style="{StaticResource Rw.NavItem}" GroupName="Nav" Tag="&#xE8EC;" Content="Names" Checked="Nav_Checked" />
            <RadioButton x:Name="NavActivity" Style="{StaticResource Rw.NavItem}" GroupName="Nav" Tag="&#xE81C;" Content="Activity" Checked="Nav_Checked" />
            <RadioButton x:Name="NavAbout" Style="{StaticResource Rw.NavItem}" GroupName="Nav" Tag="&#xE946;" Content="About" Checked="Nav_Checked" />
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,20,36,40" MaxWidth="820" HorizontalAlignment="Stretch">

                <!-- General -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Text="General" Style="{StaticResource Rw.PageTitle}" />

                    <TextBlock Text="Roamwise" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <StackPanel>
                            <ui:SettingRow Header="Auto-roam" Description="Move to a better access point of the same network on its own. When off, Roamwise still shows what it would do.">
                                <CheckBox Style="{StaticResource Rw.Toggle}" IsChecked="{Binding Enabled}" AutomationProperties.Name="Auto-roam" />
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" />
                            <ui:SettingRow x:Name="PauseRow" Header="Pause for an hour" Description="Stay on the access point you're on during a call or a big download. Auto-roam comes back on by itself.">
                                <Button x:Name="PauseButton" Style="{StaticResource Rw.Button}" Content="Pause" MinWidth="96" Click="Pause_Click" />
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" />
                            <ui:SettingRow Header="Start with Windows" Description="Runs quietly in the notification area after you sign in.">

                                <CheckBox Style="{StaticResource Rw.Toggle}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" />
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" />
                            <ui:SettingRow Header="Notify me when it switches" Description="Shows a notification each time Roamwise moves you to another access point.">
                                <CheckBox Style="{StaticResource Rw.Toggle}" IsChecked="{Binding NotifyOnRoam}" AutomationProperties.Name="Notify me when it switches" />
                            </ui:SettingRow>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Extra optimizations" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <StackPanel>
                            <ui:SettingRow Header="Low-latency mode"
                                           Description="Pauses the background scans Windows runs about once a minute, which cause lag spikes in games and calls. Roamwise keeps checking on its own schedule. Undone automatically when Roamwise closes.">
                                <CheckBox Style="{StaticResource Rw.Toggle}" IsChecked="{Binding LowLatencyMode}" AutomationProperties.Name="Low-latency mode" />
                            </ui:SettingRow>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Appearance" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <ui:SettingRow Header="Theme" Description="Match Windows, or pick one.">
                            <Border Style="{StaticResource Rw.SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Rw.Segment}" GroupName="Theme" Content="Windows"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter={x:Static core:ThemePreference.System}}" />
                                    <RadioButton Style="{StaticResource Rw.Segment}" GroupName="Theme" Content="Light"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter={x:Static core:ThemePreference.Light}}" />
                                    <RadioButton Style="{StaticResource Rw.Segment}" GroupName="Theme" Content="Dark"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter={x:Static core:ThemePreference.Dark}}" />
                                </StackPanel>
                            </Border>
                        </ui:SettingRow>
                    </Border>
                </StackPanel>

                <!-- When to switch -->
                <StackPanel x:Name="PageRoaming" Visibility="Collapsed">
                    <TextBlock Text="Switching" Style="{StaticResource Rw.PageTitle}" />
                    <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="6" Background="{DynamicResource Rw.Surface}"
                            BorderBrush="{DynamicResource Rw.CardStroke}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" CornerRadius="1.5" Background="{DynamicResource Rw.AccentText}" Margin="0,2,14,2" />
                            <TextBlock x:Name="RulesSummary" Grid.Column="1" Style="{StaticResource Rw.Body}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Checking" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <StackPanel>
                            <ui:SettingRow Header="Check every" Description="Each check is a short Wi-Fi scan. More often reacts faster but scans add a little latency.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rw.SliderValue}" Text="{Binding ScanIntervalSeconds, Converter={StaticResource Duration}}" />
                                    <Slider Width="200" VerticalAlignment="Center" Minimum="10" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding ScanIntervalSeconds}" AutomationProperties.Name="Check every" />
                                </StackPanel>
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" />
                            <ui:SettingRow Header="Check less often on battery" Description="Doubles the time between checks while unplugged.">
                                <CheckBox Style="{StaticResource Rw.Toggle}" IsChecked="{Binding SlowerOnBattery}" AutomationProperties.Name="Check less often on battery" />
                            </ui:SettingRow>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Switching rules" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <StackPanel>
                            <ui:SettingRow Header="Required improvement" Description="How much better another access point has to score before Roamwise moves you.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rw.SliderValue}" Text="{Binding MinImprovementDb, Converter={StaticResource PlusDb}}" />
                                    <Slider Width="200" VerticalAlignment="Center" Minimum="3" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding MinImprovementDb}" AutomationProperties.Name="Required improvement" />
                                </StackPanel>
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" />
                            <ui:SettingRow Header="Weakest access point to move to" Description="Never switch to an access point with a signal below this.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rw.SliderValue}" Text="{Binding MinCandidateDbm, Converter={StaticResource Dbm}}" />
                                    <Slider Width="200" VerticalAlignment="Center" Minimum="-85" Maximum="-50" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding MinCandidateDbm}" AutomationProperties.Name="Weakest access point to move to" />
                                </StackPanel>
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" />
                            <ui:SettingRow Header="Confirm over" Description="The better access point has to stay better for this many checks in a row, so a brief spike doesn't trigger a switch.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rw.SliderValue}" Text="{Binding ConfirmScans, Converter={StaticResource Checks}}" />
                                    <Slider Width="200" VerticalAlignment="Center" Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding ConfirmScans}" AutomationProperties.Name="Confirm over" />
                                </StackPanel>
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" />
                            <ui:SettingRow Header="Wait between switches" Description="After a switch, Roamwise stays put at least this long.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rw.SliderValue}" Text="{Binding CooldownSeconds, Converter={StaticResource Duration}}" />
                                    <Slider Width="200" VerticalAlignment="Center" Minimum="30" Maximum="1800" TickFrequency="30" IsSnapToTickEnabled="True"
                                            Value="{Binding CooldownSeconds}" AutomationProperties.Name="Wait between switches" />
                                </StackPanel>
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" />
                            <ui:SettingRow Header="Only switch when my signal is weak" Description="Leave a good connection alone, even if a better access point appears.">
                                <CheckBox Style="{StaticResource Rw.Toggle}" IsChecked="{Binding OnlyWhenWeak}" AutomationProperties.Name="Only switch when my signal is weak" />
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" Visibility="{Binding OnlyWhenWeak, Converter={StaticResource Visible}}" />
                            <ui:SettingRow Header="Weak means below" Description="Roamwise starts looking for a better access point once your signal drops under this."
                                           Visibility="{Binding OnlyWhenWeak, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rw.SliderValue}" Text="{Binding WeakSignalDbm, Converter={StaticResource Dbm}}" />
                                    <Slider Width="200" VerticalAlignment="Center" Minimum="-85" Maximum="-50" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding WeakSignalDbm}" AutomationProperties.Name="Weak means below" />
                                </StackPanel>
                            </ui:SettingRow>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Don't interrupt" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <StackPanel>
                            <ui:SettingRow Header="Wait while I'm using the network"
                                           Description="A switch drops the connection for a moment. Roamwise holds off while you're streaming, downloading or on a call, unless your signal is very weak.">
                                <CheckBox Style="{StaticResource Rw.Toggle}" IsChecked="{Binding HoldOffWhenBusy}" AutomationProperties.Name="Wait while I'm using the network" />
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" Visibility="{Binding HoldOffWhenBusy, Converter={StaticResource Visible}}" />
                            <ui:SettingRow Header="Busy means over" Description="Traffic through the Wi-Fi adapter since the last check. A video call uses about 2 Mbps."
                                           Visibility="{Binding HoldOffWhenBusy, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rw.SliderValue}" Text="{Binding BusyMbps, StringFormat={}{0} Mbps}" />
                                    <Slider Width="200" VerticalAlignment="Center" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding BusyMbps}" AutomationProperties.Name="Busy means over" />
                                </StackPanel>
                            </ui:SettingRow>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource Rw.Button}" Content="Restore default rules" HorizontalAlignment="Left" Margin="0,20,0,0"
                            Click="ResetRules_Click" />
                </StackPanel>

                <!-- How APs are ranked -->
                <StackPanel x:Name="PageRanking" Visibility="Collapsed">
                    <TextBlock Text="Ranking" Style="{StaticResource Rw.PageTitle}" />
                    <TextBlock Style="{StaticResource Rw.Body}" Foreground="{DynamicResource Rw.TextMuted}" Margin="0,12,0,0" MaxWidth="640" HorizontalAlignment="Left"
                               Text="Each access point gets a score that starts at its signal strength in dBm. Faster bands and wider channels add points, busy access points lose points. Bonuses fade out between −65 and −80 dBm, so a weak fast connection never beats a solid slower one." />

                    <TextBlock Text="Speed" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <StackPanel>
                            <ui:SettingRow Header="5 GHz bonus" Description="5 GHz is usually faster and less crowded than 2.4 GHz.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rw.SliderValue}" Text="{Binding Bonus5GhzDb, Converter={StaticResource PlusDb}}" />
                                    <Slider Width="200" VerticalAlignment="Center" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Bonus5GhzDb}" AutomationProperties.Name="5 GHz bonus" />
                                </StackPanel>
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" />
                            <ui:SettingRow Header="6 GHz bonus" Description="Wi-Fi 6E and 7 only. Very fast with little interference, but shorter range.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rw.SliderValue}" Text="{Binding Bonus6GhzDb, Converter={StaticResource PlusDb}}" />
                                    <Slider Width="200" VerticalAlignment="Center" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Bonus6GhzDb}" AutomationProperties.Name="6 GHz bonus" />
                                </StackPanel>
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" />
                            <ui:SettingRow Header="Avoid 2.4 GHz" Description="Scores 2.4 GHz access points 6 points lower. Leave off if you need the extra range.">
                                <CheckBox Style="{StaticResource Rw.Toggle}" IsChecked="{Binding Avoid24Ghz}" AutomationProperties.Name="Avoid 2.4 GHz" />
                            </ui:SettingRow>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Crowding" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <ui:SettingRow Header="Account for busy access points"
                                       Description="Uses how busy each access point says it is. When it doesn't say, Roamwise counts the other radios sharing its channel.">
                            <CheckBox Style="{StaticResource Rw.Toggle}" IsChecked="{Binding ConsiderLoad}" AutomationProperties.Name="Account for busy access points" />
                        </ui:SettingRow>
                    </Border>
                </StackPanel>

                <!-- Networks -->
                <StackPanel x:Name="PageNetworks" Visibility="Collapsed">
                    <TextBlock Text="Networks" Style="{StaticResource Rw.PageTitle}" />

                    <TextBlock Text="Which networks Roamwise manages" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.SegmentGroup}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Rw.Segment}" GroupName="Scope" Content="All networks, except excluded ones"
                                         IsChecked="{Binding Scope, Converter={StaticResource Is}, ConverterParameter={x:Static core:NetworkScope.AllExceptExcluded}}" />
                            <RadioButton Style="{StaticResource Rw.Segment}" GroupName="Scope" Content="Only networks I list"
                                         IsChecked="{Binding Scope, Converter={StaticResource Is}, ConverterParameter={x:Static core:NetworkScope.OnlyIncluded}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ListHeading" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <StackPanel>
                            <ItemsControl x:Name="NetworkList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Margin="16,8,8,8" MinHeight="32">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE701;" Style="{StaticResource Rw.Glyph}" Foreground="{DynamicResource Rw.TextMuted}" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Rw.Body}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Style="{StaticResource Rw.IconButton}" Content="&#xE74D;" FontSize="14"
                                                        ToolTip="Remove" AutomationProperties.Name="Remove" Tag="{Binding}" Click="RemoveNetwork_Click" />
                                            </Grid>
                                            <Border Style="{StaticResource Rw.Divider}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ListEmpty" Style="{StaticResource Rw.Caption}" FontSize="13" Margin="16,14,16,14" />
                            <Border Style="{StaticResource Rw.Divider}" x:Name="ListEmptyDivider" />
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewNetwork" VerticalContentAlignment="Center" MinHeight="32" KeyDown="NewNetwork_KeyDown"
                                         AutomationProperties.Name="Network name" />
                                <TextBlock x:Name="NewNetworkHint" Text="Network name (SSID)" IsHitTestVisible="False" Style="{StaticResource Rw.Caption}"
                                           FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <Button Grid.Column="1" Style="{StaticResource Rw.Button}" Content="Add" Margin="8,0,0,0" MinWidth="72" Click="AddNetwork_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SavedPanel">
                        <TextBlock Text="Saved on this PC" Style="{StaticResource Rw.GroupHeading}" />
                        <TextBlock Style="{StaticResource Rw.Caption}" Margin="2,-4,0,10" Text="Select a network to add it to the list." />
                        <ItemsControl x:Name="SavedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Rw.Button}" Margin="0,0,8,8" Tag="{Binding}" Click="AddSaved_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Rw.Glyph}" FontSize="12" Margin="0,1,8,0" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Access point names -->
                <StackPanel x:Name="PageNames" Visibility="Collapsed">
                    <TextBlock Text="Access point names" Style="{StaticResource Rw.PageTitle}" />
                    <TextBlock Style="{StaticResource Rw.Body}" Foreground="{DynamicResource Rw.TextMuted}" Margin="0,12,0,0" MaxWidth="640" HorizontalAlignment="Left"
                               Text="Most access points don't broadcast their name. Roamwise uses the names you give first, then the names from your controller or a list you import, then whatever the access point announces. Otherwise it shows the end of the device's MAC address." />

                    <TextBlock Text="Look up names" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <StackPanel>
                            <ui:SettingRow x:Name="SourceRow" Header="Get names from">
                                <ComboBox x:Name="SourceBox" Width="280" MinHeight="32" DisplayMemberPath="Title"
                                          SelectionChanged="SourceBox_SelectionChanged" AutomationProperties.Name="Get names from" />
                            </ui:SettingRow>

                            <StackPanel x:Name="AddressGroup">
                                <Border Style="{StaticResource Rw.Divider}" />
                                <ui:SettingRow x:Name="AddressRow">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="280">
                                            <TextBox x:Name="AddressBox" MinHeight="32" VerticalContentAlignment="Center" AutomationProperties.Name="Address" />
                                            <TextBlock x:Name="AddressHint" IsHitTestVisible="False" Style="{StaticResource Rw.Caption}"
                                                       FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                        <Button x:Name="BrowseButton" Style="{StaticResource Rw.Button}" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
                                    </StackPanel>
                                </ui:SettingRow>
                            </StackPanel>

                            <StackPanel x:Name="UserGroup">
                                <Border Style="{StaticResource Rw.Divider}" />
                                <ui:SettingRow x:Name="UserRow">
                                    <TextBox x:Name="UserBox" Width="280" MinHeight="32" VerticalContentAlignment="Center" AutomationProperties.Name="User" />
                                </ui:SettingRow>
                            </StackPanel>

                            <StackPanel x:Name="SecretGroup">
                                <Border Style="{StaticResource Rw.Divider}" />
                                <ui:SettingRow x:Name="SecretRow" Description="Stored encrypted for your Windows account. Roamwise only reads device names.">
                                    <Grid Width="280">
                                        <PasswordBox x:Name="SecretBox" MinHeight="32" VerticalContentAlignment="Center" PasswordChanged="SecretBox_PasswordChanged"
                                                     AutomationProperties.Name="Key" />
                                        <TextBlock x:Name="SecretHint" IsHitTestVisible="False" Style="{StaticResource Rw.Caption}"
                                                   FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </ui:SettingRow>
                            </StackPanel>

                            <StackPanel x:Name="ExtraGroup">
                                <Border Style="{StaticResource Rw.Divider}" />
                                <ui:SettingRow x:Name="ExtraRow">
                                    <Grid Width="280">
                                        <TextBox x:Name="ExtraBox" MinHeight="32" VerticalContentAlignment="Center" AutomationProperties.Name="Extra" />
                                        <TextBlock x:Name="ExtraHint" IsHitTestVisible="False" Style="{StaticResource Rw.Caption}"
                                                   FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </ui:SettingRow>
                            </StackPanel>

                            <StackPanel x:Name="SourceFooter">
                                <Border Style="{StaticResource Rw.Divider}" />
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SourceStatus" Style="{StaticResource Rw.Caption}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button x:Name="SourceForget" Grid.Column="1" Style="{StaticResource Rw.Button}" Content="Disconnect" Margin="0,0,8,0" Click="SourceForget_Click" />
                                    <Button x:Name="SourceConnect" Grid.Column="2" Style="{StaticResource Rw.AccentButton}" Content="Connect" MinWidth="96" Click="SourceConnect_Click" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Names you've given" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <StackPanel>
                            <ItemsControl x:Name="CustomNames">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Margin="16,8,8,8" MinHeight="32">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Rw.Body}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Rw.Caption}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource Rw.Button}" Content="Use default" Tag="{Binding Key}"
                                                        Click="ResetName_Click" />
                                            </Grid>
                                            <Border Style="{StaticResource Rw.Divider}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="CustomNamesEmpty" Style="{StaticResource Rw.Caption}" FontSize="13" Margin="16,14"
                                       Text="You haven't renamed any access points. Select one in the Roamwise panel and use the pencil button." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Activity -->
                <StackPanel x:Name="PageActivity" Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="Activity" Style="{StaticResource Rw.PageTitle}" />
                        <Button x:Name="ClearActivity" Style="{StaticResource Rw.Button}" Content="Clear activity" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="ClearActivity_Click" />
                    </Grid>
                    <TextBlock x:Name="ActivityEmpty" Style="{StaticResource Rw.Body}" Foreground="{DynamicResource Rw.TextMuted}" Margin="0,16,0,0"
                               Text="Nothing yet. Switches and problems show up here." />
                    <Border x:Name="ActivityCard" Style="{StaticResource Rw.Card}" Margin="0,20,0,0">
                        <ItemsControl x:Name="ActivityList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Margin="16,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Rw.Glyph}" FontSize="14" Foreground="{Binding GlyphBrush}"
                                                       VerticalAlignment="Top" Margin="0,3,14,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding When}" Style="{StaticResource Rw.Caption}" FontSize="13" Margin="0,1,0,0"
                                                       Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Rw.Body}" />
                                        </Grid>
                                        <Border Style="{StaticResource Rw.Divider}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="About" Style="{StaticResource Rw.PageTitle}" />
                    <Border Style="{StaticResource Rw.Card}" Margin="0,20,0,0" Padding="20,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource Rw.Logo}" Width="32" Height="32" />
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Roamwise" Style="{StaticResource Rw.Subtitle}" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Rw.Caption}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Rw.Body}" Margin="0,16,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                       Text="Windows often holds on to the first access point it joined, even after you walk away from it. On networks with many access points, Roamwise keeps checking which one is best for you and moves you there, using the saved network profile Windows already has." />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource Rw.LinkButton}" Content="Source code on GitHub" Click="OpenRepo_Click" />
                                <Button Style="{StaticResource Rw.LinkButton}" Content="Open data folder" Margin="24,0,0,0" Click="OpenData_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Updates" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <StackPanel>
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="UpdateTitle" Style="{StaticResource Rw.Body}" />
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Rw.Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="UpdateNotes" Grid.Column="1" Style="{StaticResource Rw.LinkButton}" Content="What's new" Margin="0,0,16,0"
                                        VerticalAlignment="Center" Click="UpdateNotes_Click" />
                                <Button x:Name="UpdateButton" Grid.Column="2" Style="{StaticResource Rw.Button}" Content="Check for updates" MinWidth="96"
                                        VerticalAlignment="Center" Click="Update_Click" />
                            </Grid>
                            <Border Style="{StaticResource Rw.Divider}" />
                            <ui:SettingRow Header="Check for updates automatically" Description="Looks at the project's GitHub releases once a day. Nothing else is sent.">
                                <CheckBox Style="{StaticResource Rw.Toggle}" IsChecked="{Binding CheckForUpdates}" AutomationProperties.Name="Check for updates automatically" />
                            </ui:SettingRow>
                            <Border Style="{StaticResource Rw.Divider}" Visibility="{Binding CheckForUpdates, Converter={StaticResource Visible}}" />
                            <ui:SettingRow Header="Install updates on their own" Description="Downloads, checks the release's published checksum and restarts Roamwise in the background."
                                           Visibility="{Binding CheckForUpdates, Converter={StaticResource Visible}}">
                                <CheckBox Style="{StaticResource Rw.Toggle}" IsChecked="{Binding InstallUpdatesAutomatically}" AutomationProperties.Name="Install updates on their own" />
                            </ui:SettingRow>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Troubleshooting" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <ui:SettingRow Header="Diagnostics report"
                                       Description="A text file with your adapter and every nearby access point Windows reports, for bug reports. Review it before sharing: it contains network names and MAC addresses.">
                            <Button x:Name="DiagnoseButton" Style="{StaticResource Rw.Button}" Content="Save report…" Click="Diagnose_Click" />
                        </ui:SettingRow>
                    </Border>

                    <TextBlock Text="Location access" Style="{StaticResource Rw.GroupHeading}" />
                    <Border Style="{StaticResource Rw.Card}">
                        <ui:SettingRow Header="Let desktop apps access your location"
                                       Description="Windows treats nearby access points as location data, so it only shares them with apps when this is on. Roamwise never looks up or stores your location.">
                            <Button Style="{StaticResource Rw.Button}" Content="Open location settings" Click="OpenLocation_Click" />
                        </ui:SettingRow>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
