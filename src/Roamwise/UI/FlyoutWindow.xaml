<Window x:Class="Roamwise.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Roamwise.UI"
        xmlns:core="clr-namespace:Roamwise.Core"
        Style="{x:Null}"
        Title="Roamwise" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource Rw.FontText}" Foreground="{DynamicResource Rw.Text}"
        Background="{DynamicResource Rw.FlyoutFallback}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <ui:EnumIsConverter x:Key="Is" />
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="20,12,16,18">
            <!-- App bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE701;" Style="{StaticResource Rw.Glyph}" FontSize="14" Foreground="{DynamicResource Rw.AccentText}" />
                <TextBlock Grid.Column="1" Text="Roamwise" Style="{StaticResource Rw.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <CheckBox Grid.Column="2" Style="{StaticResource Rw.Toggle}" Content="Auto-roam" FontSize="12"
                          Foreground="{DynamicResource Rw.TextMuted}" IsChecked="{Binding Enabled}" Margin="0,0,8,0"
                          ToolTip="Switch access points automatically" />
                <Button Grid.Column="3" Style="{StaticResource Rw.IconButton}" Content="&#xE713;" ToolTip="Settings"
                        AutomationProperties.Name="Settings" Click="OpenSettings_Click" />
            </Grid>

            <!-- The network you're on -->
            <Grid Margin="0,12,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SsidText" FontFamily="{StaticResource Rw.FontDisplay}" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Text="Checking Wi-Fi…" />
                    <TextBlock x:Name="LinkText" Style="{StaticResource Rw.Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel x:Name="RssiPanel" Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock x:Name="RssiText" FontFamily="{StaticResource Rw.FontDisplay}" FontSize="20" FontWeight="SemiBold"
                               TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                    <TextBlock x:Name="QualityText" Style="{StaticResource Rw.Caption}" TextAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="FieldPanel" Margin="0,0,4,0">
                <!-- Summary and sort order -->
                <Grid Margin="0,18,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RadioSummary" Style="{StaticResource Rw.Caption}" VerticalAlignment="Center" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <Border Grid.Column="1" Style="{StaticResource Rw.SegmentGroup}" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Rw.Segment}" GroupName="Sort" Content="Band" FontSize="12" Padding="9,2,9,3"
                                         ToolTip="Group by band, then channel"
                                         IsChecked="{Binding Sort, Converter={StaticResource Is}, ConverterParameter={x:Static core:ApSort.Band}}" />
                            <RadioButton Style="{StaticResource Rw.Segment}" GroupName="Sort" Content="Device" FontSize="12" Padding="9,2,9,3"
                                         ToolTip="Group the radios of each access point"
                                         IsChecked="{Binding Sort, Converter={StaticResource Is}, ConverterParameter={x:Static core:ApSort.Device}}" />
                            <RadioButton Style="{StaticResource Rw.Segment}" GroupName="Sort" Content="Best" FontSize="12" Padding="9,2,9,3"
                                         ToolTip="Best rated first"
                                         IsChecked="{Binding Sort, Converter={StaticResource Is}, ConverterParameter={x:Static core:ApSort.Best}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ui:SignalField x:Name="Field" Sort="{Binding Sort}"
                                AccentBrush="{DynamicResource Rw.Accent}"
                                AccentTextBrush="{DynamicResource Rw.AccentText}"
                                LineBrush="{DynamicResource Rw.TextFaint}"
                                AccentSoftBrush="{DynamicResource Rw.AccentSoft}"
                                TrackBrush="{DynamicResource Rw.Track}"
                                NeutralBrush="{DynamicResource Rw.BarNeutral}"
                                TextBrush="{DynamicResource Rw.Text}"
                                MutedBrush="{DynamicResource Rw.TextMuted}"
                                FaintBrush="{DynamicResource Rw.TextFaint}"
                                HoverBrush="{DynamicResource Rw.Surface}"
                                TriggerBrush="{DynamicResource Rw.Fair}" />

                <TextBlock x:Name="DecisionText" Style="{StaticResource Rw.Body}" FontSize="13" LineHeight="19" Margin="0,14,0,0" />

                <!-- Details for the access point picked in the chart -->
                <Border x:Name="DetailPanel" Margin="0,12,0,0" Padding="14,10,8,14" CornerRadius="6"
                        Background="{DynamicResource Rw.Surface}" BorderBrush="{DynamicResource Rw.CardStroke}" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DetailName" Style="{StaticResource Rw.Subtitle}" FontSize="14" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DetailId" Style="{StaticResource Rw.Caption}" FontSize="11" Foreground="{DynamicResource Rw.TextFaint}"
                                           TextWrapping="NoWrap" Margin="0,1,0,0" />
                            </StackPanel>
                            <Button x:Name="RenameButton" Grid.Column="1" Style="{StaticResource Rw.IconButton}" Content="&#xE70F;" FontSize="14"
                                    ToolTip="Rename this access point" AutomationProperties.Name="Rename this access point" Click="Rename_Click" />
                        </Grid>

                        <StackPanel x:Name="RenamePanel" Margin="0,8,6,0" Visibility="Collapsed">
                            <TextBox x:Name="RenameBox" MinHeight="30" VerticalContentAlignment="Center" KeyDown="RenameBox_KeyDown"
                                     AutomationProperties.Name="Access point name" />
                            <TextBlock Style="{StaticResource Rw.Caption}" FontSize="11" Margin="0,4,0,0"
                                       Text="Enter saves, Esc cancels. Clear it to go back to the default name." />
                        </StackPanel>

                        <Grid x:Name="DetailFacts" Margin="0,10,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <Button x:Name="SwitchButton" Style="{StaticResource Rw.AccentButton}" FontSize="13" Padding="12,4,12,5" MinHeight="30"
                                Content="Switch to this access point" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Switch_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Shown instead of the chart when there's nothing to chart -->
            <StackPanel x:Name="EmptyPanel" Margin="0,8,4,0" Visibility="Collapsed">
                <TextBlock x:Name="EmptyText" Style="{StaticResource Rw.Body}" FontSize="13" LineHeight="19" />
                <Button x:Name="EmptyAction" Style="{StaticResource Rw.Button}" FontSize="13" Padding="12,4,12,5" MinHeight="30"
                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="EmptyAction_Click" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource Rw.Footer}" BorderBrush="{DynamicResource Rw.Line}" BorderThickness="0,1,0,0"
                Padding="20,10,12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CheckedText" Style="{StaticResource Rw.Caption}" VerticalAlignment="Center" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="CheckButton" Grid.Column="1" Style="{StaticResource Rw.Button}" FontSize="13" Padding="12,4,12,5" MinHeight="30"
                        Content="Check now" Click="CheckNow_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>