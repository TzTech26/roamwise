<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutrals sit under acrylic/Mica, so most are translucent white. -->
    <SolidColorBrush x:Key="Rw.FlyoutFallback" Color="#1F2228" />
    <SolidColorBrush x:Key="Rw.FlyoutTint" Color="#B01F2228" />
    <SolidColorBrush x:Key="Rw.Footer" Color="#40000000" />
    <SolidColorBrush x:Key="Rw.Surface" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Rw.SurfaceHover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Rw.SurfacePressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Rw.CardFill" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Rw.CardStroke" Color="#1A000000" />
    <SolidColorBrush x:Key="Rw.Line" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Rw.ControlStroke" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Rw.Text" Color="#E9EBEE" />
    <SolidColorBrush x:Key="Rw.TextMuted" Color="#9AA1AA" />
    <SolidColorBrush x:Key="Rw.TextFaint" Color="#6B727C" />
    <SolidColorBrush x:Key="Rw.Track" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="Rw.BarNeutral" Color="#79818B" />
    <SolidColorBrush x:Key="Rw.Strong" Color="#3FB68B" />
    <SolidColorBrush x:Key="Rw.Fair" Color="#D9A43B" />
    <SolidColorBrush x:Key="Rw.Weak" Color="#E0705C" />
    <SolidColorBrush x:Key="Rw.KnobOff" Color="#C5C9CF" />
</ResourceDictionary>
