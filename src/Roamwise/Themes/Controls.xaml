<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Roamwise.UI">

    <FontFamily x:Key="Rw.FontText">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Rw.FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Rw.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Type scale: 11 / 12 / 14 / 20 / 28 -->
    <Style x:Key="Rw.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Rw.FontText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Rw.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Rw.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Rw.FontText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Rw.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Rw.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Rw.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Rw.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Rw.FontDisplay}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Rw.Text}" />
    </Style>
    <Style x:Key="Rw.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Rw.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Rw.Text}" />
    </Style>

    <Style x:Key="Rw.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource Rw.Text}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Rw.Button" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Rw.FontText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Rw.Text}" />
        <Setter Property="Background" Value="{DynamicResource Rw.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rw.ControlStroke}" />
        <Setter Property="Padding" Value="12,5,12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Rw.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rw.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rw.SurfacePressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource Rw.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rw.AccentButton" TargetType="Button" BasedOn="{StaticResource Rw.Button}">
        <Setter Property="Background" Value="{DynamicResource Rw.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rw.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Rw.OnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rw.IconButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Rw.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Rw.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Rw.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rw.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rw.SurfacePressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rw.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Rw.AccentText}" />
        <Setter Property="FontFamily" Value="{StaticResource Rw.FontText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Rw.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="P" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="P" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch (CheckBox), Windows 11 proportions: 40x20 track -->
    <Style x:Key="Rw.Toggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Rw.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Rw.FontText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Rw.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,1" RecognizesAccessKey="True" />
                        <Grid Width="40" Height="20">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Background="Transparent"
                                    BorderBrush="{DynamicResource Rw.KnobOff}" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                     Fill="{DynamicResource Rw.KnobOff}" />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Rw.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Rw.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Rw.OnAccent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented choice (RadioButton) -->
    <Style x:Key="Rw.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Rw.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Rw.FontText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,6,14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Rw.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rw.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rw.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Rw.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rw.SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Rw.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rw.ControlStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Left navigation in the settings window. Tag holds the glyph. -->
    <Style x:Key="Rw.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Rw.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Rw.FontText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Rw.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Height="36">
                        <Grid>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource Rw.AccentText}" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Margin="14,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Rw.Glyph}" Margin="0,0,14,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rw.Surface}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rw.Surface}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The app logo as vectors (same artwork as tools/make-icon.ps1, 64-unit grid), so it stays sharp at any size and DPI -->
    <DrawingImage x:Key="Rw.Logo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#1F2A37" Geometry="M16,2 H48 A14,14 0 0 1 62,16 V48 A14,14 0 0 1 48,62 H16 A14,14 0 0 1 2,48 V16 A14,14 0 0 1 16,2 Z" />
                <GeometryDrawing Geometry="M23.515,38.515 A12,12 0 0 1 40.485,38.515 M15.029,30.029 A24,24 0 0 1 48.971,30.029">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#E9EBEE" Thickness="5" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E9EBEE">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,47" RadiusX="4.5" RadiusY="4.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#3FB68B">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="46,17" RadiusX="7" RadiusY="7" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- A group of related settings rows -->
    <Style x:Key="Rw.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Rw.CardFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rw.CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style x:Key="Rw.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Rw.Line}" />
    </Style>
    <Style x:Key="Rw.GroupHeading" TargetType="TextBlock" BasedOn="{StaticResource Rw.Subtitle}">
        <Setter Property="Margin" Value="2,28,0,8" />
    </Style>

    <Style TargetType="ui:SettingRow">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SettingRow">
                    <Grid Margin="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The explanation shows on hover (the info mark), or always for rows marked Inline. -->
                        <StackPanel x:Name="Head" VerticalAlignment="Center" Margin="0,0,24,0" Background="Transparent"
                                    ToolTip="{TemplateBinding Description}" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Rw.Body}" />
                                <TextBlock x:Name="Info" Text="&#xE946;" Style="{StaticResource Rw.Glyph}" FontSize="12"
                                           Foreground="{DynamicResource Rw.TextFaint}" Margin="7,1,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" Style="{StaticResource Rw.Caption}" Margin="0,2,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Inline" Value="True">
                            <Setter TargetName="Desc" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Info" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Head" Property="ToolTip" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Info" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hover explanations -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Rw.FlyoutFallback}" BorderBrush="{DynamicResource Rw.CardStroke}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" MaxWidth="340" Margin="0,0,6,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                        </Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Rw.Body}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Value shown next to a slider, e.g. "−67 dBm" -->
    <Style x:Key="Rw.SliderValue" TargetType="TextBlock" BasedOn="{StaticResource Rw.Body}">
        <Setter Property="Width" Value="72" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
</ResourceDictionary>
